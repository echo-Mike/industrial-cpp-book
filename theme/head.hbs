<script src="https://unpkg.com/cookies-eu-banner@^3/dist/cookies-eu-banner.global.js"></script>
<script>
  (function () {
    // Comment this for localhost debug
    if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
      return;
    }
    document.addEventListener('DOMContentLoaded', function () {
        // Uncomment this for localhost debug
        // Object.defineProperty(navigator, 'doNotTrack', { get: () => null, configurable: true });
        // Object.defineProperty(window,    'doNotTrack', { get: () => null, configurable: true });
        CookiesEuBanner.createCookiesBanner({
          onAccept: function () {
            console.log('[consent] accepted');
            var GA_MEASUREMENT_ID = 'G-DBBQW5VPNS';
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          },
          onReject: function () {
            console.log('[consent] rejected');
          }
        });
    })
  })();
</script>